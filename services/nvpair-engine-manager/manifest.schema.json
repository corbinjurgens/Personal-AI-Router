{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PAIR engine manifest launch contract",
  "description": "Validates installation evidence, editable_launch in shared and platform runtime blocks, and the family, protocol, model naming and operation fields. Engine-manager also validates effective platform defaults and operation bindings against the declared actions.",
  "type": "object",
  "properties": {
    "manifest_version": { "type": "integer", "minimum": 1, "maximum": 2 },
    "detect": { "$ref": "#/definitions/detectionPaths" },
    "detect_required": { "$ref": "#/definitions/detectionPaths" },
    "family": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9._-]+$",
      "description": "Engine lineage that selects shared coded adapters (model store, catalogue). Defaults to the engine id."
    },
    "protocols": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["ollama-api", "openai-v1", "openai-chat", "anthropic-messages", "llamacpp-router"]
      }
    },
    "model_naming": {
      "enum": ["exact", "implied-latest-tag"]
    },
    "memory_plan": {
      "type": "object", "additionalProperties": false, "required": ["adapter"],
      "properties": { "adapter": { "const": "strata" } }
    },
    "operations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "load": { "$ref": "#/definitions/operation" },
        "unload": { "$ref": "#/definitions/operation" },
        "pull": { "$ref": "#/definitions/operation" },
        "delete": { "$ref": "#/definitions/operation" }
      }
    },
    "runtime": {
      "$ref": "#/definitions/runtime"
    },
    "platforms": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "detect": { "$ref": "#/definitions/detectionPaths" },
          "detect_required": { "$ref": "#/definitions/detectionPaths" },
          "memory_plan": { "$ref": "#/definitions/memoryPlanCommand" },
          "runtime": {
            "$ref": "#/definitions/runtime"
          }
        }
      }
    }
  },
  "allOf": [{
    "if": { "properties": { "manifest_version": { "const": 1 } } },
    "then": {
      "properties": {
        "detect_required": { "maxItems": 0 },
        "platforms": { "additionalProperties": { "properties": { "detect_required": { "maxItems": 0 } } } }
      }
    }
  }],
  "definitions": {
    "memoryPlanCommand": {
      "type": "object", "additionalProperties": false,
      "required": ["command", "working_directory"],
      "properties": {
        "command": { "type": "array", "minItems": 8, "maxItems": 8, "items": { "type": "string", "maxLength": 4096 } },
        "working_directory": { "type": "string", "minLength": 1, "maxLength": 4096 }
      },
      "description": "Engine-manager validates absolute platform paths, adapter and the exact private planning argument shape."
    },
    "detectionPaths": {
      "type": "array",
      "items": { "type": "string", "pattern": "\\S" },
      "description": "detect is ordered executable alternatives; detect_required requires every regular file and manifest_version 2 when nonempty. Engine-manager validates inherited platform values and placeholders."
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action"],
      "properties": {
        "action": { "type": "string", "minLength": 1 },
        "model_param": { "type": "string", "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$" },
        "params": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$" },
          "additionalProperties": { "type": ["string", "number", "boolean"] }
        },
        "response_timeout_s": { "type": "integer", "minimum": 1, "maximum": 1800 }
      }
    },
    "runtime": {
      "type": "object",
      "properties": {
        "editable_launch": {
          "$ref": "#/definitions/editableLaunch"
        },
        "serving": {
          "anyOf": [{"type": "null"}, {"$ref": "#/definitions/serving"}]
        }
      }
    },
    "serving": {
      "type": "object",
      "required": ["version", "models"],
      "additionalProperties": false,
      "properties": {
        "version": {"const": 1},
        "models": {
          "type": "array", "minItems": 1,
          "description": "Exact model IDs must be unique; engine-manager performs this cross-item validation.",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["modelId", "maxOutputTokens", "memory", "artifacts"],
            "properties": {
              "modelId": {"type": "string", "minLength": 1},
              "maxOutputTokens": {"$ref": "#/definitions/positiveServingInteger"},
              "expectedNativeSourceDigest": {"$ref": "#/definitions/sha256"},
              "memory": {
                "type": "object", "additionalProperties": false,
                "required": ["hostRamBytes", "vramBytes"],
                "properties": {
                  "hostRamBytes": {"$ref": "#/definitions/positiveServingInteger"},
                  "vramBytes": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
                }
              },
              "artifacts": {
                "type": "array", "minItems": 1,
                "items": {
                  "type": "object", "additionalProperties": false,
                  "required": ["role", "sha256", "provenance"],
                  "properties": {
                    "role": {"type": "string", "minLength": 1},
                    "sha256": {"$ref": "#/definitions/sha256"},
                    "provenance": {
                      "type": "object", "additionalProperties": false, "required": ["kind"],
                      "properties": {
                        "kind": {"enum": ["hf-lfs-sha256", "strata-source-verification", "verified-manifest", "one-time-sha256", "supplied-sha256"]},
                        "reference": {"type": "string"}
                      }
                    },
                    "binding": {
                      "type": "object", "additionalProperties": false,
                      "required": ["sourcePath", "resolvedTarget", "sizeBytes", "mtimeNs", "sampleSha256"],
                      "properties": {
                        "sourcePath": {"type": "string", "minLength": 1},
                        "resolvedTarget": {"type": "string", "minLength": 1},
                        "sizeBytes": {"$ref": "#/definitions/positiveServingInteger"},
                        "mtimeNs": {"type": "string", "pattern": "^(0|-?[1-9][0-9]*)$", "description": "Canonical decimal int64 nanoseconds; checked by engine-manager."},
                        "sampleSha256": {"$ref": "#/definitions/sha256"}
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "positiveServingInteger": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "editableLaunch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "controls"
      ],
      "properties": {
        "fixed_args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "start_index": {
          "type": "integer",
          "minimum": 0
        },
        "controls": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/control"
          }
        }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value"
      ],
      "anyOf": [
        {
          "required": [
            "flags"
          ]
        },
        {
          "required": [
            "env"
          ]
        }
      ],
      "properties": {
        "flags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?:-[a-zA-Z]|--[a-zA-Z0-9_-]+)$"
          }
        },
        "env": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
          }
        },
        "value": {
          "type": "string",
          "pattern": "^(?:[^{}]*\\{(?:server\\.(?:host|port)|cors\\.(?:enabled|origins))\\})+[^{}]*$",
          "description": "Binds policy fields using literal separators; fields must be unique, separated and share ownership. Engine-manager validates these cross-field constraints."
        },
        "implicit": {
          "type": "string",
          "description": "Value supplied by flag presence. Environment sources still take explicit values. Must parse as the declared value and may not bind managed server fields."
        }
      },
      "dependencies": {
        "implicit": [
          "flags"
        ]
      }
    }
  }
}
