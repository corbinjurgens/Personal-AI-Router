{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PAIR engine manifest launch contract",
  "description": "Validates editable_launch in shared and platform runtime blocks, and the family, protocol, model naming and operation fields. Other engine manifest fields are validated by engine-manager, which also checks operation bindings against the declared actions.",
  "type": "object",
  "properties": {
    "family": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9._-]+$",
      "description": "Engine lineage that selects shared coded adapters (model store, catalogue). Defaults to the engine id."
    },
    "protocols": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["ollama-api", "openai-v1", "anthropic-messages", "llamacpp-router"]
      }
    },
    "model_naming": {
      "enum": ["exact", "implied-latest-tag"]
    },
    "operations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "load": { "$ref": "#/definitions/operation" },
        "unload": { "$ref": "#/definitions/operation" },
        "pull": { "$ref": "#/definitions/operation" },
        "delete": { "$ref": "#/definitions/operation" }
      }
    },
    "runtime": {
      "$ref": "#/definitions/runtime"
    },
    "platforms": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "runtime": {
            "$ref": "#/definitions/runtime"
          }
        }
      }
    }
  },
  "definitions": {
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action"],
      "properties": {
        "action": { "type": "string", "minLength": 1 },
        "model_param": { "type": "string", "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$" },
        "params": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$" },
          "additionalProperties": { "type": ["string", "number", "boolean"] }
        },
        "response_timeout_s": { "type": "integer", "minimum": 1, "maximum": 1800 }
      }
    },
    "runtime": {
      "type": "object",
      "properties": {
        "editable_launch": {
          "$ref": "#/definitions/editableLaunch"
        }
      }
    },
    "editableLaunch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "controls"
      ],
      "properties": {
        "fixed_args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "start_index": {
          "type": "integer",
          "minimum": 0
        },
        "controls": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/control"
          }
        }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value"
      ],
      "anyOf": [
        {
          "required": [
            "flags"
          ]
        },
        {
          "required": [
            "env"
          ]
        }
      ],
      "properties": {
        "flags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?:-[a-zA-Z]|--[a-zA-Z0-9_-]+)$"
          }
        },
        "env": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
          }
        },
        "value": {
          "type": "string",
          "pattern": "^(?:[^{}]*\\{(?:server\\.(?:host|port)|cors\\.(?:enabled|origins))\\})+[^{}]*$",
          "description": "Binds policy fields using literal separators; fields must be unique, separated and share ownership. Engine-manager validates these cross-field constraints."
        },
        "implicit": {
          "type": "string",
          "description": "Value supplied by flag presence. Environment sources still take explicit values. Must parse as the declared value and may not bind managed server fields."
        }
      },
      "dependencies": {
        "implicit": [
          "flags"
        ]
      }
    }
  }
}
