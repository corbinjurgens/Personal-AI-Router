{
  "$schema": "../manifest.schema.json",
  "engine": "llamacpp",
  "display_name": "llama.cpp",
  "manifest_version": 1,
  "family": "llamacpp",
  "protocols": ["llamacpp-router", "openai-v1"],
  "model_naming": "exact",
  "install": { "mode": "user" },
  "models_dir": "~/.llamacpp",
  "uninstall": { "remove": ["{install_dir}"] },
  "runtime": {
    "editable_launch": {
      "fixed_args": ["--sleep-idle-seconds", "300", "--ctx-size", "8192", "--parallel", "1", "--cache-ram", "512"],
      "controls": [
        { "flags": ["--host"], "value": "{server.host}" },
        { "flags": ["--port"], "value": "{server.port}" },
        { "flags": ["--cors-origins"], "value": "{cors.origins}" }
      ]
    },
    "args": ["--sleep-idle-seconds", "300", "--ctx-size", "8192", "--parallel", "1", "--cache-ram", "512", "--host", "{host}", "--port", "{port}", "--cors-origins", ""],
    "env": { "LLAMA_CACHE": "{models_dir}" },
    "bind": "127.0.0.1",
    "port": 8081,
    "ready": { "http": "http://127.0.0.1:{port}/props", "status": 200, "timeout_s": 60, "json_match": { "field": "role", "value": "router" } },
    "stop": { "signal": "term", "grace_s": 10 },
    "health": { "http": "http://127.0.0.1:{port}/health", "status": 200, "interval_s": 5 }
  },
  "platforms": {
    "windows/amd64": {
      "detect": ["{install_dir}\\llama-server.exe"],
      "install": {
        "artifacts": [
          { "name": "server", "url": "https://github.com/ggml-org/llama.cpp/releases/download/b12020/llama-b12020-bin-win-cuda-12.4-x64.zip", "sha256": "5e19eb50eb774f373f6e3a7c4c30e50b6fe758509592f3d2598a5b7dd296ab5c" },
          { "name": "cudart", "url": "https://github.com/ggml-org/llama.cpp/releases/download/b12020/cudart-llama-bin-win-cuda-12.4-x64.zip", "sha256": "8c79a9b226de4b3cacfd1f83d24f962d0773be79f1e7b75c6af4ded7e32ae1d6" }
        ],
        "run": ["powershell.exe", "-NoProfile", "-NonInteractive", "-Command", "& { $ErrorActionPreference = 'Stop'; Expand-Archive -LiteralPath $env:NVPAIR_INSTALL_DOWNLOAD_SERVER -DestinationPath $env:NVPAIR_INSTALL_DIR -Force; Expand-Archive -LiteralPath $env:NVPAIR_INSTALL_DOWNLOAD_CUDART -DestinationPath $env:NVPAIR_INSTALL_DIR -Force }"]
      },
      "runtime": { "bin": "{install_dir}\\llama-server.exe" }
    },
    "windows/arm64": {
      "detect": ["{install_dir}\\llama-server.exe"],
      "install": {
        "artifacts": [
          { "name": "server", "url": "https://github.com/ggml-org/llama.cpp/releases/download/b12020/llama-b12020-bin-win-cuda-13.4-arm64.zip", "sha256": "800cbb6a27996d453ae64c1ba9134f6770e5b8f764975f2ce89f99a2799ef88b" },
          { "name": "cudart", "url": "https://github.com/ggml-org/llama.cpp/releases/download/b12020/cudart-llama-bin-win-cuda-13.4-arm64.zip", "sha256": "642dcde8805b3e3165ca710a5443b3b4044b27d96bd3ee3132473988c9bcb774" }
        ],
        "run": ["powershell.exe", "-NoProfile", "-NonInteractive", "-Command", "& { $ErrorActionPreference = 'Stop'; Expand-Archive -LiteralPath $env:NVPAIR_INSTALL_DOWNLOAD_SERVER -DestinationPath $env:NVPAIR_INSTALL_DIR -Force; Expand-Archive -LiteralPath $env:NVPAIR_INSTALL_DOWNLOAD_CUDART -DestinationPath $env:NVPAIR_INSTALL_DIR -Force }"]
      },
      "runtime": { "bin": "{install_dir}\\llama-server.exe" }
    },
    "linux/amd64": {
      "detect": ["{install_dir}/llama-server"],
      "install": {
        "artifacts": [
          { "name": "server", "url": "https://github.com/ggml-org/llama.cpp/releases/download/b12020/llama-b12020-bin-ubuntu-cuda-12.8-x64.tar.gz", "sha256": "0170c61c0ddf6208215a68b36f78f45b1641631317736c093f3faa40f05f8e85" },
          { "name": "cudart", "url": "https://github.com/ggml-org/llama.cpp/releases/download/b12020/cudart-llama-b12020-bin-ubuntu-cuda-12.8-x64.tar.gz", "sha256": "a17d59ed20873a82cbf2ff6c651d5bb432689d8569b4af0b6b1c7e35aeb001ba" }
        ],
        "run": ["sh", "-c", "tar -xzf \"$1\" -C \"$3\" --strip-components=1 && tar -xzf \"$2\" -C \"$3\" --strip-components=1", "llamacpp-install", "{download_server}", "{download_cudart}", "{install_dir}"]
      },
      "runtime": { "bin": "{install_dir}/llama-server", "env": { "LD_LIBRARY_PATH": "{install_dir}" } }
    },
    "linux/arm64": {
      "detect": ["{install_dir}/llama-server"],
      "install": {
        "artifacts": [
          { "name": "server", "url": "https://github.com/ggml-org/llama.cpp/releases/download/b12020/llama-b12020-bin-ubuntu-cuda-13.4-arm64.tar.gz", "sha256": "fbcbbeaf85da61972422dbb0cd9eb60193e962e930ce2485438b19461e630cf8" },
          { "name": "cudart", "url": "https://github.com/ggml-org/llama.cpp/releases/download/b12020/cudart-llama-b12020-bin-ubuntu-cuda-13.4-arm64.tar.gz", "sha256": "1a409aaa503fdaf286451b34a9166b0eb75ffe35e2f741d3344259461acbd6f3" }
        ],
        "run": ["sh", "-c", "tar -xzf \"$1\" -C \"$3\" --strip-components=1 && tar -xzf \"$2\" -C \"$3\" --strip-components=1", "llamacpp-install", "{download_server}", "{download_cudart}", "{install_dir}"]
      },
      "runtime": { "bin": "{install_dir}/llama-server", "env": { "LD_LIBRARY_PATH": "{install_dir}" } }
    },
    "darwin/arm64": {
      "detect": ["{install_dir}/llama-server"],
      "install": {
        "fetch": { "url": "https://github.com/ggml-org/llama.cpp/releases/download/b12020/llama-b12020-bin-macos-arm64.tar.gz", "sha256": "b630ebd5da34b02e86f7294dd5743aba842a0a02cb023130debd64599721c541" },
        "run": ["tar", "-xzf", "{download}", "-C", "{install_dir}", "--strip-components=1"]
      },
      "runtime": { "bin": "{install_dir}/llama-server" }
    },
    "darwin/amd64": {
      "detect": ["{install_dir}/llama-server"],
      "install": {
        "fetch": { "url": "https://github.com/ggml-org/llama.cpp/releases/download/b12020/llama-b12020-bin-macos-x64.tar.gz", "sha256": "774fba46a668cf6c94eb8d515b2dfb5897878ab6da08943585f487a1dd1aa6a0" },
        "run": ["tar", "-xzf", "{download}", "-C", "{install_dir}", "--strip-components=1"]
      },
      "runtime": { "bin": "{install_dir}/llama-server" }
    }
  },
  "operations": {
    "load": { "action": "load_model" },
    "unload": { "action": "unload_model" },
    "pull": { "action": "pull_model" },
    "delete": { "action": "delete_model" }
  },
  "actions": {
    "list_models": {
      "description": "List models available in the managed llama.cpp cache.",
      "http": { "method": "GET", "path": "/models" },
      "result": { "array": "data", "field": "id" }
    },
    "loaded_models": {
      "description": "List models currently resident in memory.",
      "http": { "method": "GET", "path": "/models" },
      "result": { "array": "data", "field": "id", "match": { "field": "status.value", "in": ["loaded"] } }
    },
    "pull_model": {
      "description": "Download a model into the managed cache (params: {\"model\": \"<Hugging Face repo:quant>\"}).",
      "http": { "method": "POST", "path": "/models", "body_schema": { "model": "string" } },
      "progress_protocol": "llamacpp-models-sse"
    },
    "load_model": {
      "description": "Load a cached model into memory (params: {\"model\": \"<model>\"}).",
      "http": { "method": "POST", "path": "/models/load", "body_schema": { "model": "string" } }
    },
    "unload_model": {
      "description": "Unload a model from memory (params: {\"model\": \"<model>\"}).",
      "http": { "method": "POST", "path": "/models/unload", "body_schema": { "model": "string" } }
    },
    "delete_model": {
      "description": "Delete a model from the managed cache (params: {\"model\": \"<model>\"}).",
      "http": { "method": "DELETE", "path": "/models", "params_in": "query" }
    }
  }
}
